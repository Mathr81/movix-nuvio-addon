{
  "name": "movix-nuvio-addon",
  "version": "1.0.0",
  "private": true,
  "description": "Addon Stremio/Nuvio personnel agregeant le catalogue TMDB et les flux Movix (usage prive, non destine a etre publie/partage).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop movix-addon",
    "pm2:restart": "pm2 restart movix-addon",
    "pm2:logs": "pm2 logs movix-addon",
    "nuvio:push": "node -e \"require('./src/nuvioPush').pushToNuvio().then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "nuvio:push:dry": "node -e \"require('./src/nuvioPush').pushToNuvio({dryRun:true}).then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "trakt:auth": "node -e \"require('./src/traktCloud').deviceAuth().catch(e=>{console.error(e.message);process.exit(1)})\"",
    "trakt:push": "node -e \"require('./src/traktPush').pushToTrakt().then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "trakt:push:dry": "node -e \"require('./src/traktPush').pushToTrakt({dryRun:true}).then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "hub:once": "node -e \"require('./src/hub').runCycle().then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "hub:dry": "node -e \"require('./src/hub').runCycle({dryRun:true}).then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "simkl:auth": "node -e \"require('./src/simklCloud').pinAuth().catch(e=>{console.error(e.message);process.exit(1)})\"",
    "simkl:probe": "node -e \"require('./src/simklProbe').probeSimkl()\"",
    "simkl:push": "node -e \"require('./src/simklPush').pushToSimkl().then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "simkl:push:dry": "node -e \"require('./src/simklPush').pushToSimkl({dryRun:true}).then(s=>console.log(JSON.stringify(s,null,2))).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "stremio-addon-sdk": "^1.6.10"
  }
}
