# Port d'ecoute de l'addon (ecoute sur toutes les interfaces)
PORT=8787

# URL publique par laquelle l'appareil de lecture (iPad, TV, PC) joint cet addon.
# Sert a construire les liens de sous-titres -- si elle est absente ou fausse, les
# sous-titres ne se chargeront pas sur les appareils distants.
# Exemple Tailscale : http://100.94.130.120:8787
PUBLIC_URL=

# URL de base de l'API Mainapi reellement utilisee par le site (ex: https://api.movix.fun)
MAIN_API_BASE_URL=

# PROXIES_EMBED_BASE_URL a ete RETIRE. proxiesembed n'accepte plus aucun appel direct:
# ses routes d'extraction (/api/extract-*, /api/voe/m3u8) exigent une cle interne partagee
# avec Mainapi seul, et ses routes de proxy n'acceptent plus qu'une URL signee en HMAC.
# L'addon ne le contacte donc plus jamais lui-meme -- il se contente de SUIVRE les URLs
# signees que Mainapi lui rend. Laisse cette variable de cote, elle n'a plus d'effet.

# Domaine spoofe dans Origin/Referer pour passer le domainRestriction de Mainapi.
# Doit correspondre au domaine courant du site (l'allowlist est cote serveur).
SPOOFED_ORIGIN=https://movix.fun

# Icone de l'addon. Par defaut <SPOOFED_ORIGIN>/favicon.ico, donc elle suit
# automatiquement les changements de domaine. A renseigner seulement pour forcer autre chose.
# LOGO_URL=

# Ta cle VIP personnelle (table access_keys) -- injectee automatiquement dans chaque requete
# sortante, en en-tete `x-access-key`.
#
# ELLE EST DEVENUE INDISPENSABLE. Movix a ferme ses endpoints d'extraction publics: il
# n'existe plus nulle part de route "extrais-moi cette URL". Ce sont maintenant les routes
# catalogue qui resolvent les m3u8 elles-memes, quand on leur passe `resolve=1` ET une cle
# VIP valide (cf. MOVIX_RESOLVE plus bas). Sans cette cle, l'addon ne peut extraire que
# voe, darkibox et oneupload -- qu'il sait lire seul -- et toutes les autres sources ne
# rendront que des liens d'embed injouables.
VIP_ACCESS_KEY=

# Demander la resolution serveur des flux (`?resolve=1`). Sans interet a couper en usage
# normal: c'est le seul chemin vers une URL jouable pour la plupart des hebergeurs.
# N'a d'effet qu'avec une VIP_ACCESS_KEY valide.
MOVIX_RESOLVE=true

# Cle TMDB pour le catalogue/metadata (peut reprendre celle de VITE_TMDB_API_KEY cote frontend)
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR

# --- Forme des identifiants de contenu ------------------------------------
# Gouverne A LA FOIS les ids servis par l'addon (catalogues, fiches, episodes) et les
# `content_id` ecrits dans Nuvio. Les deux DOIVENT s'accorder: Nuvio enregistre la
# progression sous l'id de la fiche qu'il lit, donc servir une forme et en pousser une
# autre cree deux entrees pour le meme titre (c'est l'origine des doublons).
#
#   imdb   tt0903747    aligne sur Cinemeta et les autres addons: une serie ouverte
#                       depuis cet addon ou depuis un autre est la MEME fiche, avec une
#                       seule progression. Coute une resolution TMDB -> IMDb par titre,
#                       mise en cache 24 h (la correspondance ne change jamais).
#   tmdb   tmdb:1396    aucun appel supplementaire, mais les titres n'ont rien en commun
#                       avec ceux des addons indexes par IMDb.
#
# Changer ce reglage: relancer `npm run nuvio:merge` pour basculer les entrees deja
# enregistrees vers la nouvelle forme.
ID_FORMAT=imdb

# --- Sync compte Movix (catalogues "Ma liste", "Favoris") -----------------
# A recuperer dans le localStorage du site (F12 > Application > Local Storage):
#   MOVIX_JWT        <- cle "auth_token"
#   MOVIX_USER_ID    <- cle "user_id"
#   MOVIX_PROFILE_ID <- cle "selected_profile_id" (obligatoire si le compte a des profils)
# Laisser vide desactive purement et simplement ces catalogues.
MOVIX_JWT=
MOVIX_USER_ID=
MOVIX_USER_TYPE=bip39
# Optionnel: si absent, le profil par defaut renvoye par l'API est utilise automatiquement.
MOVIX_PROFILE_ID=
SYNC_TTL_MS=300000

# --- Push vers Nuvio Sync (compte cloud Nuvio) ----------------------------
# Copie la watchlist, les favoris, les titres vus et les positions de lecture de
# Movix vers ton compte Nuvio. C'est le SEUL moyen d'obtenir une vraie reprise de
# lecture: le protocole d'addon ne permet pas de positionner le curseur.
# Declenchement manuel: curl -X POST http://localhost:8787/nuvio/push
# (ajouter ?dryRun=1 pour simuler sans rien ecrire)
NUVIO_EMAIL=
NUVIO_PASSWORD=
# Profil Nuvio (numerique). Vide = premier profil du compte.
NUVIO_PROFILE_INDEX=
# Ramener les entrees qui ne sont pas dans la forme ID_FORMAT vers celle-ci (voir plus
# haut). Sans frais quand il n'y a rien a fusionner. Pour regarder avant d'agir:
#   npm run nuvio:merge:dry     (ou GET /debug/nuvio/duplicates)
NUVIO_MERGE_LEGACY_IDS=true
# Push automatique periodique en ms. 0 = desactive. Ex: 3600000 pour toutes les heures.
NUVIO_PUSH_INTERVAL_MS=0

# --- Pont Trakt (recommande) ----------------------------------------------
# Trakt est le hub d'historique de l'ecosysteme: Nuvio s'y connecte nativement (dans ses
# reglages) et scrobble tout seul ce que tu regardes, et les addons de recommandation le
# lisent. Importer l'historique Movix ici, c'est le rendre exploitable partout.
#
# 1. Cree une app sur https://trakt.tv/oauth/applications
#    Redirect URI: urn:ietf:wg:oauth:2.0:oob   (obligatoire pour le device code)
# 2. Colle Client ID / Client Secret ci-dessous
# 3. `npm run trakt:auth` -> saisis le code affiche sur trakt.tv/activate
# 4. `npm run trakt:push:dry` puis `npm run trakt:push`
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Date attribuee aux visionnages Movix non horodates: "released" (date de sortie, garde un
# historique credible) ou "now" (tout date d'aujourd'hui).
TRAKT_WATCHED_AT=released
# Push automatique periodique en ms. 0 = desactive.
TRAKT_PUSH_INTERVAL_MS=0
# Rangee "Recommandé pour vous" alimentee par l'algorithme Trakt (necessite l'autorisation).
TRAKT_RECOMMENDATIONS=true

# --- Hub de synchronisation bidirectionnel --------------------------------
# Fait circuler les donnees dans les deux sens entre Movix et Nuvio Sync, et les recopie
# vers Simkl. C'est ce qui permet de regarder indifferemment sur le site ou dans Nuvio
# sans perdre sa place. Necessite MOVIX_JWT + NUVIO_EMAIL/NUVIO_PASSWORD.
HUB_ENABLED=false
# Delai entre deux cycles (plancher 15000). C'est la latence percue quand tu lances un
# film sur le site avant qu'il apparaisse dans Nuvio. 5 min suffit pour un usage courant
# et menage Movix, Nuvio et Simkl; descendre a 20-45 s pour une reprise quasi immediate.
HUB_INTERVAL_MS=300000
# Propager les suppressions: retirer un titre de sa liste quelque part le retire partout.
# Sans ca, une suppression est annulee au cycle suivant par les deux autres systemes.
# Destructif: n'active qu'apres avoir verifie qu'un cycle normal se comporte bien.
HUB_PROPAGATE_DELETIONS=false
# Coupe-circuit: au-dela de ce nombre de disparitions en un cycle, on suppose une lecture
# incomplete plutot qu'un menage volontaire, et rien n'est propage.
HUB_MAX_REMOVALS_PER_CYCLE=10
# Journal JSONL de toutes les ecritures (data/hub-journal.jsonl). Les retraits y sont
# consignes avec l'element retire: c'est ce qui rend `npm run hub:undo` possible.
HUB_JOURNAL=true
# Duree de conservation du journal, en jours (menage au demarrage puis chaque jour).
# Un retrait plus vieux ne peut plus etre annule par `hub:undo`. 0 = tout garder.
HUB_JOURNAL_RETENTION_DAYS=30

# --- Pont Simkl (alternative sans limite, integree nativement par Nuvio) ---
# A privilegier sur Trakt si tu n'as pas Trakt VIP: un compte Trakt gratuit n'autorise
# qu'UNE application tierce connectee a la fois, et Nuvio occupe ce slot.
# 1. Cree une app sur https://simkl.com/settings/developer (Redirect URI: urn:ietf:wg:oauth:2.0:oob)
# 2. Colle le Client ID ci-dessous (pas de secret necessaire)
# 3. `npm run simkl:auth` -> saisis le code sur simkl.com/pin
# 4. `npm run simkl:push:dry` puis `npm run simkl:push`
SIMKL_CLIENT_ID=
SIMKL_PUSH_INTERVAL_MS=0
# Avec Docker, le jeton doit vivre dans le volume (docker-compose.yml le fixe deja a
# /app/data/.simkl-token.json). Un .simkl-token.json a la racine du depot n'est PAS lu
# par le conteneur: Simkl parait alors "non autorise", sans autre message.
# SIMKL_TOKEN_FILE=
# Delai minimal entre deux lectures de Simkl par le hub (plancher 5 min). La doc Simkl
# demande 15-30 min et suspend les client_id qui relisent la bibliotheque en boucle.
SIMKL_POLL_INTERVAL_MS=900000
# Positions de lecture envoyees en /scrobble/pause, seulement si elles different de celles
# de Simkl, et au plus N par cycle (Simkl: 1 POST/s, verrou d'ecriture par utilisateur).
SIMKL_SCROBBLE=true
SIMKL_SCROBBLE_MAX_PER_CYCLE=5
# Appels Simkl (et eux seuls) par un proxy SOCKS5, si Simkl bloque l'IP du serveur
# ("403 Blocked. Please contact support@simkl.com"). Avec le conteneur nas-tunnel:
# socks5h://nas-tunnel:1080 (le "h" fait resoudre le DNS par le proxy). Aucun repli en
# direct si le proxy tombe. Le conteneur rejoint pour cela le reseau `tunnel-net`.
# SIMKL_PROXY_URL=socks5h://nas-tunnel:1080

# Rangee "Recommandé pour toi", calculee depuis l'historique Movix via TMDB.
# Ne demande aucun compte tiers et n'a aucune limite.
LOCAL_RECOMMENDATIONS=true

# --- Optionnel ------------------------------------------------------------

# Rangees integrees affichees, dans l'ordre. Vide = toutes, dans l'ordre par defaut
# (accueil facon Netflix, cf. src/catalog/rows.js). L'ordre est aussi la priorite du
# dedoublonnage: un titre n'apparait que dans la premiere rangee qui le montre.
# Ids: watchlist, reco, trakt-reco, trending, new, airing, netflix, france, thriller,
#      prime, comedy, anime, disney, action, korea, scifi, apple, crime, horror, gems,
#      canal, truestory, acclaimed, miniseries, romance, max, cult, heist, docs, family,
#      popular, favorites
# CATALOGS=watchlist,reco,trending,new,netflix,thriller,comedy
# Mise en page de l'accueil refaite au plus tard toutes les 6 h (ms). Les rangees
# thematiques changent aussi de melange chaque jour.
# CATALOG_REFRESH_MS=21600000
# Pour renommer une rangee ou en creer de nouvelles: copier catalogs.example.json en
# catalogs.json (il prend alors le pas sur CATALOGS).

# Afficher le debit reel a cote de la resolution dans la liste des streams.
# Coute un aller-retour par lien: passer a false si l'ouverture des fiches devient lente.
PROBE_BITRATE=true
PROBE_TIMEOUT_MS=3500
# Segments peses pour estimer le debit d'une playlist, repartis sur toute sa duree.
# Un encodage a debit variable rend un prelevement unique tres peu fiable: sur un profil
# VBR simule, 1 prelevement donne 26% d'erreur moyenne (93% au 90e centile), 5 en donnent
# 13% (21%). Les pesees sont paralleles et ne telechargent pas les segments.
PROBE_SEGMENT_SAMPLES=5
# FACULTATIF, et desormais rarement utile: les flux resolus par Movix arrivent DEJA
# proxifies par ses soins, la sonde n'a qu'a les suivre. Attention, ni le /proxy de Movix
# (signature HMAC obligatoire) ni l'ancien micro-service bypass403 (supprime de l'amont) ne
# conviennent ici. A renseigner seulement si tu exposes toi-meme un /proxy/<url>.
PROBE_PROXY_BASE_URL=
# Budget de la phase de mesure pour UNE ouverture de fiche. Passe ce delai, les liens
# restants sont rendus sans debit (rien n'est fige en cache, la mesure sera retentee).
# C'est le garde-fou qui empeche un CDN muet de retarder la liste entiere. 0 = illimite.
PROBE_PHASE_BUDGET_MS=9000
# Mesures menees de front (elles attendent surtout le reseau).
PROBE_CONCURRENCY=10
# Definition lue dans le flux par ffprobe, en DERNIER recours: beaucoup de playlists de
# segments n'ont aucun master au-dessus d'elles et n'annoncent donc aucune RESOLUTION (les
# flux KissKH, par exemple, s'affichaient avec leur debit et sans definition). ffprobe ne
# lit que l'entete du premier segment, et seulement si ni la playlist ni le libelle du lien
# n'ont rien appris. Compter 1 a 2,5 s sur un CDN distant, une seule fois (mise en cache).
PROBE_RESOLUTION=true
PROBE_RESOLUTION_TIMEOUT_MS=8000
# ffprobe est livre avec ffmpeg (deja requis par le calage des sous-titres).
FFPROBE_PATH=ffprobe
# Reponse en deux temps: passe ce delai, la liste part avec les debits deja mesures et les
# sondes restantes continuent seules. Nuvio redemande /stream a chaque ouverture de fiche:
# ce qui manque au premier affichage est la au second. 0 = tout attendre (ancien comportement).
STREAM_FIRST_ANSWER_MS=2500
# Duree de vie d'une liste de streams: c'est elle qui decide au bout de combien de temps un
# lien apparu depuis sera vu tout seul. La baisser rafraichit plus souvent, au prix d'un
# scan complet a chaque fois.
STREAM_TTL_MS=1800000
# Rouvrir la meme fiche N fois en peu de temps vaut demande de nouveau scan (le protocole
# Stremio n'a pas de bouton "recharger"). Ouvrir compte pour un: 3 = ouvrir + rafraichir
# deux fois. 0 desactive la detection.
STREAM_REFRESH_HITS=3
STREAM_REFRESH_WINDOW_MS=25000
# Extractions menees de front (elles tapent un service unique: inutile de le bousculer).
EXTRACT_CONCURRENCY=6
# Disjoncteur: apres N PANNES d'affilee (5xx, timeout), un hebergeur est ecarte pendant ce
# delai. Un 4xx parle d'UNE video et ne compte pas -- sans quoi trois videos supprimees
# suffiraient a couper un hebergeur en bon etat.
HOSTER_FAILURE_STREAK=3
HOSTER_COOLDOWN_MS=120000

# --- Lisibilite de la liste de streams -------------------------------------
# compact = ecarte les liens redondants (ceux qu'un autre de la MEME source surclasse a la
#           fois en resolution ET en debit: personne ne choisira le 480p a 1,1 Mb/s quand
#           le meme fournisseur donne 1080p a 2,3), puis limite a MAX_STREAMS_PER_SOURCE.
# complet = propose TOUT ce qui a ete resolu, sans rien masquer.
# Dans les deux cas /debug/streams montre la totalite.
STREAM_LIST=compact
# Mode compact uniquement: au plus N liens par source. Garder plus d'un preserve un repli
# quand un hebergeur est en panne. Compte par famille de langue (VF / VOSTFR / VO); les
# places vont d'abord a une autre langue (VFF/VFQ), puis a un autre hebergeur, puis a un
# palier inferieur du meme.
# 0 = pas de limite (les redondants restent ecartes).
MAX_STREAMS_PER_SOURCE=2
# Definition minimale proposee a Nuvio (720 = ni 480p ni moins). Un lien de definition
# inconnue reste propose. S'applique aussi en mode complet. 0 = aucun plancher.
MIN_STREAM_QUALITY=720
# Sous-addons par langue: une categorie par langue dans l'ecran de choix de Nuvio. Installer
# <PUBLIC_URL>/vf/manifest.json, /vostfr/manifest.json et /vo/manifest.json EN PLUS de
# l'addon principal (qui garde catalogues et sous-titres). A true, l'addon principal ne
# rend plus de streams -- sinon chaque lien apparaitrait deux fois.
STREAM_SPLIT_BY_LANG=false

# Restreindre les sources Movix interrogees (noms: PurStream, Links, Coflix, FrenchStream,
# FStream, Wiflix, Cpasmal, 1jour1film, VoirDrama, KissKH).
# Vide = toutes. Utile pour accelerer si tu n'utilises que PurStream.
# N'affecte PAS les addons, qui ont leur propre reglage (ENABLED_ADDONS ci-dessous).
# ENABLED_SOURCES=PurStream,Coflix,FStream

# KissKH (dramas et films asiatiques). La piste audio est en version originale; le
# libelle passe a VOSTFR quand la reponse porte une piste de sous-titres francaise.
# Ses sous-titres sont rattaches au stream: OpenSubtitles couvre mal ce catalogue.
KISSKH_LANG=VO
KISSKH_LANG_VOSTFR=VOSTFR

# --- Addons (sources autonomes, sans Mainapi ni cle VIP) -------------------
# Ids installes: aether, obrigoz, cinejoy, movy. Vide = tous.
# ENABLED_ADDONS=aether,obrigoz,cinejoy,movy

# Proxy de flux interne: c'est lui qui rejoue les Origin/Referer/User-Agent exiges par les
# CDN de ces sources et reecrit les playlists m3u8. Sans lui, leurs liens repondent 403.
STREAM_PROXY_ENABLED=true
# Secret de signature des URLs proxifiees (sans lui la route serait un relais HTTP ouvert).
# Vide = secret aleatoire a chaque demarrage: les liens deja ouverts dans Nuvio cessent
# alors de fonctionner apres un restart. Mets n'importe quelle chaine longue et fixe.
STREAM_PROXY_SECRET=
STREAM_PROXY_TIMEOUT_MS=20000
# Journal de ce que le lecteur demande reellement (methode, Range, issue). Utile quand un
# flux marche sur un appareil et pas sur un autre: iOS sonde en HEAD/Range, Android non.
# Verbeux -- a n'activer que le temps d'un diagnostic.
#
# A false, le proxy ne dit plus rien d'une lecture normale: un lecteur qui coupe la
# connexion (seek, changement de piste, arret) declenchait un avertissement a chaque fois
# alors que c'est le deroulement attendu. Les vraies pannes (amont en 4xx/5xx, timeout)
# restent journalisees dans tous les cas.
STREAM_PROXY_LOG=false
# IMPORTANT: les liens des addons passent par PUBLIC_URL. Si elle est vide ou fausse,
# l'appareil de lecture ne joindra pas le proxy et les streams echoueront.

# Aether (films et series). Serveurs disponibles: aurora, lul, link (VO), gallic (VF).
# ATTENTION: cette ligne fige la liste. Si tu la copies telle quelle dans un .env, un
# serveur ajoute plus tard n'apparaitra pas -- le demarrage le signale alors en clair.
AETHER_SERVERS=aurora,lul,link,gallic
AETHER_SITE_ORIGIN=https://aether.bar
AETHER_API_DOMAIN=aether.cx
# Origin/Referer exiges par le CDN tiers du serveur "link".
AETHER_LINK_ORIGIN=https://nextgencloudfabric.com
# Gallic n'est pas sur AETHER_API_DOMAIN: il a sa propre base d'API.
AETHER_GALLIC_API=https://api.pope-walrus-spiffy.workers.dev
# Aucune des API n'annonce la langue: etiquette appliquee pour le tri (cf. PREFERRED_LANGS).
AETHER_LANG=VO
AETHER_GALLIC_LANG=VF

# Obrigoz (films uniquement, recherche par titre TMDB).
OBRIGOZ_BASE_URL=https://obrigoz.com
# Segment de chemin volatil du site (https://obrigoz.com/<prefix>/home/obrigoz).
# Si la recherche ne renvoie plus rien, c'est en general lui qui a change.
OBRIGOZ_PATH_PREFIX=2662df1
OBRIGOZ_LANG=VF

# --- Cinejoy (films et series) --------------------------------------------
# Canal scelle lumen-gate-v2 pilote via le wasm embarque (src/addons/vendor/crush.wasm).
# Aucune cle. Depuis un serveur, le POST passe en fetch natif (pas de curl-impersonate).
# Septembre 2026: API passee de api.shegu.st a api.wing.st, site de cinejoy.to a
# cinejoy.pk. S'ils rebougent: ouvrir /watch/movie/<tmdb> du site, relever le domaine du
# POST .../g et du GET .../crush.wasm, et remplacer le wasm vendorise (voir README).
CINEJOY_ENDPOINT=https://api.wing.st/g
CINEJOY_ORIGIN=https://cinejoy.pk
# Serveurs interroges en parallele. Vide = ceux que <api>/servers annonce "ok".
# CINEJOY_SERVERS=Lisbon,Nebula,Solara,Athens
CINEJOY_TIMEOUT_MS=10000
CINEJOY_LANG=VO

# --- Movy (films et series, 4K) -------------------------------------------
# API de movy.sx (reponses chiffrees enc=2, dechiffreur porte dans src/addons/movy.js).
# Cloudflare bloque l'IP du VPS sur l'API: elle passe par le tunnel NAS. Le CDN video
# se joint en direct (le proxy de flux rejoue le Referer exige).
MOVY_API=https://api.wecollege.net
MOVY_ORIGIN=https://www.movy.sx
# Serveurs interroges en parallele (miami/boise = VO jusqu'au 2160p; paris = VF, en panne 10/2026).
MOVY_SERVERS=miami,boise
MOVY_PROXY_URL=socks5h://nas-tunnel:1080
MOVY_TIMEOUT_MS=10000
MOVY_LANG=VO

# --- Sous-titres (codes ISO 639-2/B: fre, eng, ger, dut, gre, rum, per...) ---
SUBTITLES_ENABLED=true
SUBTITLE_LANGS=fre,eng
# Fournisseurs interroges, DANS L'ORDRE. La cascade se fait PAR LANGUE: le second n'est
# appele que pour les langues que le premier n'a pas fournies (et pas du tout s'il a tout).
#
#   vdrk           pistes deja en WebVTT, index adresse par id TMDB, sans cle ni quota.
#                  Rien a decompresser, rien a convertir, aucun encodage a deviner.
#   opensubtitles  plus fourni sur les titres anciens ou confidentiels, mais il faut
#                  passer par l'id IMDb, une requete PAR LANGUE, puis un .gz de SRT dont
#                  l'encodage n'est pas annonce (souvent du latin-1, qui casse les accents).
SUBTITLE_PROVIDERS=vdrk,opensubtitles
VDRK_BASE_URL=https://sub.vdrk.site
VDRK_ORIGIN=https://aether.bar
# Pistes proposees par langue (les meilleures d'abord). Au-dela de 1, elles portent
# toutes le meme nom de langue -- le protocole ne les distingue que par leur id.
SUBTITLES_PER_LANG=1
# Afficher "· vdrk" a cote de la langue. La specification prevoit qu'un libelle libre soit
# affiche tel quel, mais Nuvio normalise ce champ et rend "inconnu" tout ce qui n'est pas
# un code ISO 639-2. A n'activer que si ton lecteur suit la specification.
SUBTITLE_PROVIDER_LABEL=false

# --- Calage automatique des sous-titres ---
# Les flux viennent de sources diverses, les sous-titres d'un index qui ne les connait pas:
# rien ne garantit qu'ils decrivent le meme montage ni la meme cadence. L'addon ecoute
# quelques fenetres du flux avec ffmpeg, compare les instants de parole a ceux des
# repliques, et en deduit le decalage -- et la DERIVE, quand la piste vient d'une conversion
# PAL (25 im/s au lieu de 23,976: cinq minutes d'ecart en fin de film, que le reglage de
# delai d'un lecteur ne rattrape pas).
# Sans ffmpeg installe, tout ceci se desactive tout seul: les pistes sont servies telles
# quelles, exactement comme avant.
SUBTITLE_AUTOSYNC=true
FFMPEG_PATH=ffmpeg
# Comment l'addon sait QUEL flux caler (le protocole Stremio ne le dit pas):
#   playback  observe -- le proxy de flux vient de servir la playlist du flux choisi. Sans
#             risque, mais aveugle aux liens qui ne passent pas par le proxy.
#   stream    les pistes sont rattachees a CHAQUE flux (`stream.subtitles`): identification
#             exacte, y compris hors proxy. Suppose que le lecteur lise ces pistes-la, et
#             elles peuvent apparaitre EN DOUBLE avec celles de la ressource `subtitles`.
#   both      les deux, pour les lecteurs qui ignorent l'une ou l'autre.
SUBTITLE_AUTOSYNC_BIND=playback
# Caler d'apres le flux le MIEUX CLASSE quand aucun n'a ete observe. Desactive par defaut:
# se tromper de release applique un decalage faux partout, plus penible a rattraper que
# l'absence de calage.
SUBTITLE_AUTOSYNC_GUESS_STREAM=false
# Fenetres d'ecoute reparties dans le film, et leur duree. Il en faut aux DEUX bouts: c'est
# l'ecart entre elles qui revele une derive.
SUBTITLE_AUTOSYNC_WINDOWS=6
SUBTITLE_AUTOSYNC_WINDOW_SECONDS=90
# Nombre minimal de fenetres qui doivent s'accorder, et etendue minimale (fraction du film)
# entre la premiere et la derniere d'entre elles. Deux fenetres voisines ne demontrent rien:
# un calage juste rassemble 4 a 6 fenetres sur 6, reparties d'un bout a l'autre.
SUBTITLE_AUTOSYNC_MIN_WINDOWS=3
SUBTITLE_AUTOSYNC_MIN_REACH=0.6
SUBTITLE_AUTOSYNC_CONCURRENCY=2
SUBTITLE_AUTOSYNC_WINDOW_TIMEOUT_MS=60000
# Decalage maximal cherche. Au-dela, ce n'est plus un decalage, c'est une autre piste.
SUBTITLE_AUTOSYNC_MAX_SHIFT=120
# Chercher aussi une DERIVE de cadence (conversion PAL), en plus du decalage constant. A
# laisser actif: cela ne coute que du calcul, et une derive non corrigee est le seul defaut
# qu'un reglage de delai ne rattrape pas. A couper si l'on ne rencontre jamais que des
# decalages constants et qu'on prefere ecarter tout risque de derive inventee.
SUBTITLE_AUTOSYNC_DRIFT=true
# De combien une derive doit l'emporter sur "aucune derive", et combien de fois la dispersion
# des mesures elle doit representer pour etre affirmee. Une derive de 0,1 % sur un episode de
# 45 min vaut 2,7 s en tout: si les fenetres se dispersent deja de 3 s, ce n'est pas une
# mesure mais du bruit ajuste. Une vraie conversion PAL passe sans difficulte.
SUBTITLE_AUTOSYNC_DRIFT_MARGIN=0.25
SUBTITLE_AUTOSYNC_DRIFT_EVIDENCE=3
# Seuil de confiance. EN DESSOUS, LA PISTE EST SERVIE TELLE QUELLE -- un calage approximatif
# est pire que pas de calage. Calibre sur de l'audio de FILM (musique et ambiances continues):
# sur deux longs-metrages de reference un calage juste sort a 0,40-0,42, et des sous-titres
# pris sur un autre film plafonnent a 0,16.
SUBTITLE_AUTOSYNC_MIN_CONFIDENCE=0.2
# Seuil abaisse quand DEUX pistes du meme titre, calees separement, tombent sur la meme
# correspondance -- a condition qu'elles soient reellement independantes (beaucoup de
# traductions partagent un seul fichier de minutage et rendent donc la meme mesure).
SUBTITLE_AUTOSYNC_MIN_CONFIDENCE_PAIR=0.08
SUBTITLE_AUTOSYNC_PAIR_TOLERANCE=0.5
SUBTITLE_AUTOSYNC_PAIR_MAX_SHARED=0.4
SUBTITLE_AUTOSYNC_MIN_CUES=60
# Un calage trouve reste valable tant que la source sert le meme release (7 jours).
SUBTITLE_AUTOSYNC_TTL_MS=604800000
# Delai que /subtitle accepte d'attendre quand le calage n'est pas encore pret; au-dela il
# sert la piste brute (le calcul continue, la piste ressortira calee a la reselection).
SUBTITLE_AUTOSYNC_WAIT_MS=20000
# Nombre de flux dont le calage est prepare des l'affichage de la liste. Le declenchement
# le plus utile reste celui de la premiere requete du proxy: la, on ne suppose plus rien.
SUBTITLE_AUTOSYNC_PREFETCH=1
SUBTITLE_AUTOSYNC_PLAYBACK_WINDOW_MS=1800000

# Motifs de detection supplementaires, au format "hebergeur:motif" (regex, insensible a la
# casse). Voe renouvelle ses domaines de sortie environ tous les mois, avec des noms qui ne
# contiennent pas "voe" (ralphysuccessfull.com, prepareddare.com...): un domaine plus
# recent que la liste integree passe pour "sans extracteur" alors qu'il est extractible.
# La liste integree est celle de l'amont (Mainapi/utils/embedExtraction.js), reprise telle
# quelle. /debug/extract/... liste les hotes non reconnus; ajoute ici ceux qui sont du voe:
# ils seront alors pris par l'extracteur voe LOCAL, qui n'a besoin de rien d'autre.
# Verifier d'abord que c'est bien du voe (page avec un <script type="application/json">):
# bysebuho (Byse, captcha) et playmogo (DoodStream) ne le sont PAS, contrairement a ce
# que cet exemple suggerait.
# HOSTER_PATTERNS_EXTRA=voe:nouveaudomaine

# Proposer les embeds sans extracteur (vidara.to, lecteurvideo.com...) en "ouvrir dans le
# navigateur". Couvre aussi les liens que SEUL Movix sait extraire et qu'il n'a pas resolus,
# ainsi que les chaines de TV en direct servies en iframe (NorthLive, rencontres sportives).
# Ils ne sont pas lisibles dans Nuvio/Stremio, d'ou le defaut a false.
SHOW_UNPLAYABLE_EMBEDS=false

# --- TV en direct ----------------------------------------------------------------------
# Movix expose un triplet manifest/catalog/stream deja au format Stremio (/api/livetv/...).
# L'addon le relaie: cela ajoute le type `tv` au manifest et une rangee par catalogue.
#
# Toutes les chaines ne sont pas jouables par un lecteur video: Vavoo (HLS gratuit), la
# playlist M3U locale du serveur et l'IPTV Xtream (VIP) le sont; NorthLive et les
# rencontres sportives sont servis en IFRAME et n'apparaissent qu'avec
# SHOW_UNPLAYABLE_EMBEDS=true, en "ouvrir dans le navigateur". Les rencontres Streamed
# sont converties en flux natifs avec une cle VIP.
# Desactivee par defaut: elle ajoute le type `tv` et des dizaines de rangees au manifest.
LIVETV_ENABLED=false
# Catalogues retenus, tels que Movix les nomme. Vide = tous ceux qu'il annonce, ce qui fait
# beaucoup de rangees (une par pays Vavoo, une par sport en cours).
# LIVETV_CATALOGS=vavoo_france,vavoo_france-sport

# --- Playlist IPTV -----------------------------------------------------------------------
# Les chaines de Movix pour un LECTEUR IPTV (TiviMate, IPTV Smarters, VLC, Kodi...) plutot
# que pour Nuvio. Tous les flux d'une meme chaine -- Vavoo (3 fournisseurs), bouquet IPTV
# VIP, playlists tierces -- sont fusionnes en UNE entree; au moment de zapper, l'addon
# teste les meilleurs et redirige vers le premier qui repond.
#
#   M3U     <PUBLIC_URL>/iptv/<IPTV_TOKEN>/playlist.m3u      (?sources=all: un flux par ligne)
#   Guide   <PUBLIC_URL>/iptv/<IPTV_TOKEN>/epg.xml.gz        (ou epg.xml)
#   Xtream  serveur <PUBLIC_URL>, identifiant libre, mot de passe = IPTV_TOKEN
#   Etat    <PUBLIC_URL>/iptv/<IPTV_TOKEN>/channels.json     (?q=tf1, ?unmatched=1)
#   Reglage page "Chaines" de la WebUI (/ui/#/chaines): masquer, fusionner, forcer un flux
#
# Independant de LIVETV_ENABLED (qui ajoute les chaines dans Nuvio).
IPTV_ENABLED=false
# Jeton d'acces, OBLIGATOIRE: ces routes donnent les flux VIP du compte a qui les appelle.
# Generer avec `openssl rand -hex 16`.
IPTV_TOKEN=
# Groupes Vavoo lus (noms Movix sans `vavoo_`): france, france-sport, germany, italy...
# `none` = aucun.
# IPTV_VAVOO_GROUPS=france,france-sport
# Categories du bouquet IPTV VIP retenues, par prefixe ("FR | KIDS TV"). `*` = les 167
# categories, `none` = aucune. Demande VIP_ACCESS_KEY.
# IPTV_XTREAM_PREFIXES=FR
# Playlists M3U tierces a fusionner: Nom|URL|PREFIXE (prefixe optionnel, filtre sur
# group-title ou sur le nom), separees par des virgules.
# IPTV_EXTRA_M3U=Perso|https://exemple.org/liste.m3u|FR
# Ordre de preference des sources.
# IPTV_SOURCE_ORDER=xtream,vavoo,m3u
# Ce qui classe les flux d'une chaine. `source` (defaut): la source preferee d'abord --
# l'IPTV VIP passe devant un Vavoo mieux defini. `quality`: la meilleure definition
# d'abord, la source ne departageant que les ex aequo.
# IPTV_RANK_BY=source
# Sert un master HLS a plusieurs variantes (une par definition disponible) au lieu d'une
# redirection: le lecteur propose alors un choix de qualite. Contrepartie: un lecteur a
# debit adaptatif peut changer de variante, donc de fournisseur, de lui-meme.
IPTV_VARIANTS=false
# Ronde de sante (ms): teste tous les flux en tache de fond et mesure leur definition
# reelle avec ffprobe. Les flux morts passent en queue, la definition mesuree remplace
# celle du libelle. ~1400 flux, 20 a 30 min la premiere fois. 0 = pas de ronde.
# IPTV_SWEEP_MS=21600000
# IPTV_SWEEP_CONCURRENCY=3
# Retire de la playlist une chaine dont aucun flux ne repond depuis deux rondes (jamais le
# sport ni les canaux evenementiels, eteints par nature hors antenne).
# IPTV_HIDE_DEAD=true
# Definition maximale preferee (2160, 1080, 720); au-dessus, le flux passe en dernier
# recours. Utile si l'appareil peine sur la 4K HEVC. 0 = pas de plafond.
# IPTV_MAX_QUALITY=0
# Guide des programmes XMLTV (.xml ou .xml.gz), filtre sur les chaines de la playlist.
# Vide = pas de guide. xmltv_tnt.xml.gz est plus leger (TNT seule).
# IPTV_EPG_URL=https://xmltvfr.fr/xmltv/xmltv_fr.xml.gz
# IPTV_EPG_REFRESH_MS=43200000
# Relecture des sources (ms).
# IPTV_REFRESH_MS=3600000
# Teste les flux au zap et bascule si le meilleur est mort. false = toujours le premier.
# IPTV_CHECK_STREAMS=true
# IPTV_CHECK_TIMEOUT_MS=4000
# Patience au zap pour un flux IPTV: le bouquet demarre ses chaines a la demande, une
# chaine froide met 3 a 11 s a repondre. Passe ce delai, bascule sur le flux suivant.
# IPTV_XTREAM_WAIT_MS=6000
# Journalise le flux retenu a chaque zap.
# IPTV_LOG=false

# Cache memoire (ms). Les resultats vides expirent plus vite pour permettre un retry.
CACHE_TTL_MS=1800000
CACHE_EMPTY_TTL_MS=120000
# Le cache survit au redemarrage (data/cache.json, ecrit de facon atomique). Sans lui, un
# `npm start` fait repayer a la premiere ouverture de chaque fiche le scraping, l'extraction
# et la mesure de debit. Les entrees expirees ne sont ni ecrites ni relues.
CACHE_PERSIST=true
# CACHE_FILE=/chemin/vers/cache.json
CACHE_SAVE_INTERVAL_MS=60000

# Prepare l'episode SUIVANT pendant qu'on regarde celui-ci: c'est la seule suite previsible
# d'une ouverture de fiche. Le delai laisse d'abord la fiche en cours finir ses mesures.
PREFETCH_NEXT_EPISODE=true
PREFETCH_DELAY_MS=15000

# Langues privilegiees dans le tri des streams (tout le reste passe apres, a resolution egale)
PREFERRED_LANGS=MULTI,VFF,VFQ,VF,TRUEFRENCH,FRENCH

# --- WebUI (/ui) ------------------------------------------------------------
# Tableau de bord: sante, testeur de titre, synchro/trackers, logs en direct.
# Elle peut DECLENCHER des ecritures (push, restauration du hub, autorisations): si l'addon
# est expose sur Internet, la proteger -- par WEBUI_PASSWORD, ou au reverse proxy sur /ui.
WEBUI_ENABLED=true
# Vide = aucune authentification integree. Sinon HTTP Basic: nom d'utilisateur libre, seul
# le mot de passe compte. Les routes Stremio (/manifest.json, /stream...) restent publiques.
WEBUI_PASSWORD=
# Lignes de console gardees en memoire pour la page Logs (rien n'est ecrit sur disque).
WEBUI_LOG_LINES=2000
