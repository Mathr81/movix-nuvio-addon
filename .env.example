# Port d'ecoute de l'addon (installe dans Stremio/Nuvio via http://<host>:<port>/manifest.json)
PORT=8787

# URL de base de l'API Mainapi reellement utilisee par movix.cash (ex: https://api.movix.cash)
MAIN_API_BASE_URL=

# URL de base du service Python proxiesembed (extraction voe/uqload/vidzy/fsvid/vidmoly/sibnet/doodstream/seekstreaming)
PROXIES_EMBED_BASE_URL=

# Domaine spoofe dans Origin/Referer pour passer le domainRestriction de Mainapi (doit etre dans l'allowlist de security.js)
SPOOFED_ORIGIN=https://movix.cash

# Ta cle VIP personnelle (table access_keys) -- injectee automatiquement dans chaque requete sortante
VIP_ACCESS_KEY=

# Cle TMDB pour le catalogue/metadata (peut reprendre celle de VITE_TMDB_API_KEY cote frontend)
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
