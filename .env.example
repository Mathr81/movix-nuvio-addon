# Port d'ecoute de l'addon (ecoute sur toutes les interfaces)
PORT=8787

# URL publique par laquelle l'appareil de lecture (iPad, TV, PC) joint cet addon.
# Sert a construire les liens de sous-titres -- si elle est absente ou fausse, les
# sous-titres ne se chargeront pas sur les appareils distants.
# Exemple Tailscale : http://100.94.130.120:8787
PUBLIC_URL=

# URL de base de l'API Mainapi reellement utilisee par movix.cash (ex: https://api.movix.cash)
MAIN_API_BASE_URL=

# URL de base du service Python proxiesembed (extraction voe/uqload/vidzy/fsvid/vidmoly/sibnet/doodstream/seekstreaming)
PROXIES_EMBED_BASE_URL=

# Domaine spoofe dans Origin/Referer pour passer le domainRestriction de Mainapi.
# Doit correspondre au domaine courant du site (l'allowlist est cote serveur).
SPOOFED_ORIGIN=https://movix.fun

# Icone de l'addon. Par defaut <SPOOFED_ORIGIN>/favicon.ico, donc elle suit
# automatiquement les changements de domaine. A renseigner seulement pour forcer autre chose.
# LOGO_URL=

# Ta cle VIP personnelle (table access_keys) -- injectee automatiquement dans chaque requete sortante
VIP_ACCESS_KEY=

# Cle TMDB pour le catalogue/metadata (peut reprendre celle de VITE_TMDB_API_KEY cote frontend)
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR

# --- Sync compte Movix (catalogues "Reprendre", "Ma liste", "Favoris") ----
# A recuperer dans le localStorage du site (F12 > Application > Local Storage):
#   MOVIX_JWT        <- cle "auth_token"
#   MOVIX_USER_ID    <- cle "user_id"
#   MOVIX_PROFILE_ID <- cle "selected_profile_id" (obligatoire si le compte a des profils)
# Laisser vide desactive purement et simplement ces catalogues.
MOVIX_JWT=
MOVIX_USER_ID=
MOVIX_USER_TYPE=bip39
# Optionnel: si absent, le profil par defaut renvoye par l'API est utilise automatiquement.
MOVIX_PROFILE_ID=
SYNC_TTL_MS=300000

# --- Push vers Nuvio Sync (compte cloud Nuvio) ----------------------------
# Copie la watchlist, les favoris, les titres vus et les positions de lecture de
# Movix vers ton compte Nuvio. C'est le SEUL moyen d'obtenir une vraie reprise de
# lecture: le protocole d'addon ne permet pas de positionner le curseur.
# Declenchement manuel: curl -X POST http://localhost:8787/nuvio/push
# (ajouter ?dryRun=1 pour simuler sans rien ecrire)
NUVIO_EMAIL=
NUVIO_PASSWORD=
# Profil Nuvio (numerique). Vide = premier profil du compte.
NUVIO_PROFILE_INDEX=
# imdb (recommande, aligne sur Cinemeta et la plupart des addons) ou tmdb
NUVIO_ID_PREFERENCE=imdb
# Push automatique periodique en ms. 0 = desactive. Ex: 3600000 pour toutes les heures.
NUVIO_PUSH_INTERVAL_MS=0

# --- Pont Trakt (recommande) ----------------------------------------------
# Trakt est le hub d'historique de l'ecosysteme: Nuvio s'y connecte nativement (dans ses
# reglages) et scrobble tout seul ce que tu regardes, et les addons de recommandation le
# lisent. Importer l'historique Movix ici, c'est le rendre exploitable partout.
#
# 1. Cree une app sur https://trakt.tv/oauth/applications
#    Redirect URI: urn:ietf:wg:oauth:2.0:oob   (obligatoire pour le device code)
# 2. Colle Client ID / Client Secret ci-dessous
# 3. `npm run trakt:auth` -> saisis le code affiche sur trakt.tv/activate
# 4. `npm run trakt:push:dry` puis `npm run trakt:push`
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Date attribuee aux visionnages Movix non horodates: "released" (date de sortie, garde un
# historique credible) ou "now" (tout date d'aujourd'hui).
TRAKT_WATCHED_AT=released
# Push automatique periodique en ms. 0 = desactive.
TRAKT_PUSH_INTERVAL_MS=0
# Rangee "Recommandé pour vous" alimentee par l'algorithme Trakt (necessite l'autorisation).
TRAKT_RECOMMENDATIONS=true

# --- Hub de synchronisation bidirectionnel --------------------------------
# Fait circuler les donnees dans les deux sens entre Movix et Nuvio Sync, et les recopie
# vers Simkl. C'est ce qui permet de regarder indifferemment sur le site ou dans Nuvio
# sans perdre sa place. Necessite MOVIX_JWT + NUVIO_EMAIL/NUVIO_PASSWORD.
HUB_ENABLED=false
# Delai entre deux cycles (plancher 15000). C'est la latence percue quand tu lances un
# film sur le site avant qu'il apparaisse dans Nuvio.
HUB_INTERVAL_MS=45000

# --- Pont Simkl (alternative sans limite, integree nativement par Nuvio) ---
# A privilegier sur Trakt si tu n'as pas Trakt VIP: un compte Trakt gratuit n'autorise
# qu'UNE application tierce connectee a la fois, et Nuvio occupe ce slot.
# 1. Cree une app sur https://simkl.com/settings/developer (Redirect URI: urn:ietf:wg:oauth:2.0:oob)
# 2. Colle le Client ID ci-dessous (pas de secret necessaire)
# 3. `npm run simkl:auth` -> saisis le code sur simkl.com/pin
# 4. `npm run simkl:push:dry` puis `npm run simkl:push`
SIMKL_CLIENT_ID=
SIMKL_PUSH_INTERVAL_MS=0

# Rangee "Parce que tu as regardé", calculee depuis l'historique Movix via TMDB.
# Ne demande aucun compte tiers et n'a aucune limite.
LOCAL_RECOMMENDATIONS=true

# --- Optionnel ------------------------------------------------------------

# Rangees integrees affichees, dans l'ordre. Vide = toutes, dans l'ordre par defaut.
# Ids: continue, watchlist, favorites, reco, trakt-reco, trending, popular, toprated, new
# CATALOGS=continue,watchlist,reco,trending,popular
# Pour renommer une rangee ou en creer de nouvelles: copier catalogs.example.json en
# catalogs.json (il prend alors le pas sur CATALOGS).

# Afficher le debit reel a cote de la resolution dans la liste des streams.
# Coute un aller-retour par lien: passer a false si l'ouverture des fiches devient lente.
PROBE_BITRATE=true
PROBE_TIMEOUT_MS=3500

# Restreindre les sources interrogees (noms: PurStream, Coflix, FrenchStream, FStream, Wiflix, Cpasmal, 1jour1film).
# Vide = toutes. Utile pour accelerer si tu n'utilises que PurStream.
# ENABLED_SOURCES=PurStream,Coflix,FStream

# Sous-titres OpenSubtitles (codes ISO 639-2)
SUBTITLES_ENABLED=true
SUBTITLE_LANGS=fre,eng

# Proposer les embeds sans extracteur (vidara.to, lecteurvideo.com...) en "ouvrir dans le navigateur".
# Ils ne sont pas lisibles dans Nuvio/Stremio, d'ou le defaut a false.
SHOW_UNPLAYABLE_EMBEDS=false

# Cache memoire (ms). Les resultats vides expirent plus vite pour permettre un retry.
CACHE_TTL_MS=1800000
CACHE_EMPTY_TTL_MS=120000

# Langues privilegiees dans le tri des streams (tout le reste passe apres, a resolution egale)
PREFERRED_LANGS=MULTI,VFF,VFQ,VF,TRUEFRENCH,FRENCH
